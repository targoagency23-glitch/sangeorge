        "companyNameAr": {
          "type": "string",
          "description": "Company name in Arabic"
        },
        "taglineEn": {
          "type": "string",
          "description": "Slogan in English"
        },
        "taglineAr": {
          "type": "string",
          "description": "Slogan in Arabic"
        },
        "logoUrl": {
          "type": "string",
          "description": "Custom logo URL"
        },
        "aboutTextEn": {
          "type": "string",
          "description": "About section in English"
